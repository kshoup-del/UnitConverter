
@page "{conversionType?}/{input?}"
@model UnitConverter.Pages.ConversionsModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>@ViewData["Title"]</title>
</head>
<body>
<div>
    <h1>@ViewData["Title"]</h1>
    @if (ViewData["ErrorMessage"] != null)
    {
        <p class="text-danger">@ViewData["ErrorMessage"]</p>
    }
    else
    {
        <p>Conversion: @ViewData["ConversionType"]</p>
        <p>Conversion Type: @Model.ConversionType</p>
        <p> Input:@Model.Input </p>
        <p> Output: @Model.Output </p>
    }
    <p>
        <a href="/">Return to the conversion form</a>
    </p>

</div>
</body>
</html>
