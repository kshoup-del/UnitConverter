@page
@using UnitConverter.Models
@model UnitConverter.Pages.QuickConversions

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>Quick Conversions</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<
<h1>Quick Conversions</h1>
<a asp-page="/Index">Back to Index</a>
<div class="container mt-4">

    <form method="get" asp-page-handler="@ConversionTypes.MilesToKilometers" class="mt-4">
        <label for="miles" class="form-label">Miles:</label>
        <input id="miles" name="Input" type="text" class="form-control">

        <button type="submit" class="btn btn-primary mt-2">Convert</button>
    </form>

    <form method="get" asp-page-handler="@ConversionTypes.KilometersToMiles" class="mt-4">
        <label for="kilometers" class="form-label">Kilometers:</label>
        <input id="kilometers" name="Input" type="number" class="form-control">

        <button type="submit" class="btn btn-primary mt-2">Convert</button>
    </form>

    <form method="get" asp-page-handler="@ConversionTypes.FahrenheitToCelsius" class="mt-4">
        <label for="fahrenheit" class="form-label">Fahrenheit:</label>
        <textarea id="fahrenheit" name="Input" type="text" class="form-control"></textarea>

        <button type="submit" class="btn btn-primary mt-2">Convert</button>
    </form>

    <form method="get" asp-page-handler="@ConversionTypes.CelsiusToFahrenheit" class="mt-4">
        <label for="celsius" class="form-label">Celsius (0-100):</label>
        <input id="celsius" name="Input" type="range" min="0" max="100" step="1" class="form-control">


        <button type="submit" class="btn btn-primary mt-2">Convert</button>
    </form>

    <form method="get" asp-page-handler="@ConversionTypes.PoundsToKilograms" class="mt-4">
        <label for="pounds" class="form-label">Pounds:</label>
        <select id="pounds" name="Input" asp-items="Model.PoundOptions" class="form-select"></select>

        <button type="submit" class="btn btn-primary mt-2">Convert</button>
    </form>

    <form method="get" asp-page-handler="@ConversionTypes.KilogramsToPounds" class="mt-4" >
        <label for="kilograms" class="form-label">Kilograms:</label>
        <input id="kilograms" name="Input" type="number" class="form-control">

        <button type="submit" class="btn btn-primary mt-2">Convert</button>
    </form>

    <form method="get" asp-page-handler="@ConversionTypes.FeetToMeters" class="mt-4" >
        <label for="feet" class="form-label">Feet:</label>
        <input id="feet" name="Input" type="text" class="form-control">

        <button type="submit" class="btn btn-primary mt-2">Convert</button>
    </form>

    <form method="get" asp-page-handler="@ConversionTypes.MetersToFeet" class="mt-4">
        <label for="meters" class="form-label">Meters:</label>
        <input id="meters" name="Input" type="text" class="form-control">

        <button type="submit" class="btn btn-primary mt-2">Convert</button>
    </form>
</div>
</body>
</html>
